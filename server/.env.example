DATABASE_URL=postgres://usuario:senha@host:5432/albumrate
JWT_SECRET=troque-por-uma-senha-longa-e-secreta
PORT=8080

# Origens permitidas no CORS (separadas por vírgula). Apps nativos não enviam Origin.
# Inclua a origem do web do Expo (localhost:8081) e a URL do web em produção, se houver.
CORS_ORIGINS=http://localhost:8081

# Login com Spotify (OAuth). O SPOTIFY_CLIENT_ID precisa ser o mesmo do app.
# O SPOTIFY_CLIENT_SECRET também serve de proxy para a busca de álbuns do app
# (GET /api/spotify/search) — nunca configure o secret no .env do app.
# Gere TOKEN_ENCRYPTION_KEY com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=

# E-mails de administradores (separados por vírgula, comparados em lowercase).
# Quem estiver aqui vira admin automaticamente no primeiro login/abertura do app.
ADMIN_EMAILS=
