{
  "cli": {
    "version": ">= 21.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://albumrate-server.onrender.com",
        "EXPO_PUBLIC_SPOTIFY_CLIENT_ID": "78e9e0e6e0b943749e6dda552598907f"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://albumrate-server.onrender.com",
        "EXPO_PUBLIC_SPOTIFY_CLIENT_ID": "78e9e0e6e0b943749e6dda552598907f"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
