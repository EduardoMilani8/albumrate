EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
# URL do backend. Com o server local e teste no celular, use o IP da máquina na LAN
# (ex.: http://192.168.0.10:8080) — localhost não funciona no celular.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Login com Spotify (OAuth): o EXPO_PUBLIC_SPOTIFY_CLIENT_ID é usado no fluxo PKCE no app.
# O client secret NUNCA vai no app — a busca de álbuns é feita via proxy do servidor
# (GET /api/spotify/search) usando SPOTIFY_CLIENT_ID/SECRET + TOKEN_ENCRYPTION_KEY
# do server/.env (ver server/.env.example). Registre no painel do Spotify o redirect
# URI do app (albumrate:// na build final; exp://... no Expo Go).
