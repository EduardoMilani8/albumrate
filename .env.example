EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
EXPO_PUBLIC_SPOTIFY_CLIENT_SECRET=
EXPO_PUBLIC_API_URL=https://seu-app.up.railway.app

# Login com Spotify (OAuth): o EXPO_PUBLIC_SPOTIFY_CLIENT_ID é usado no fluxo PKCE no app.
# O client secret NUNCA vai no app — o servidor usa SPOTIFY_CLIENT_ID/SECRET + TOKEN_ENCRYPTION_KEY
# do server/.env (ver server/.env.example). Registre no painel do Spotify o redirect URI do app
# (albumrate:// na build final; exp://... no Expo Go).
